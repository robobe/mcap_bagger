{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web server",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "mcap-bagger",
        "server",
        "--config",
        "config/recorder.yaml",
        "--host",
        "0.0.0.0",
        "--port",
        "9090"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "icon": {
        "id": "play",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "${input:testCommand}",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testCommand",
      "type": "pickString",
      "description": "Select a test tool",
      "options": [
        {
          "label": "Desktop player",
          "value": "uv run --locked mcap-bagger player"
        },
        {
          "label": "Publish streams (10 seconds)",
          "value": "uv run --locked python examples/run_demo.py --config config/recorder.yaml --publish-only"
        },
        {
          "label": "Record demo (10 seconds)",
          "value": "uv run --locked python examples/run_demo.py --config config/recorder.yaml"
        },
        {
          "label": "MCAP summary",
          "value": "read -r -p \"MCAP file path: \" mcap_path && uv run --locked python examples/summarize_mcap.py \"$mcap_path\""
        }
      ]
    }
  ]
}
